# Enterprise LLM Guardrail & Gateway - Environment Example

# Gateway Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Upstream LLM Configuration (Leave OPENAI_API_KEY empty for simulated fallback mode)
# For Local Ollama (Live GPU mode):
#   OPENAI_API_KEY=ollama
#   UPSTREAM_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
#   DEFAULT_MODEL=qwen2.5:1.5b
OPENAI_API_KEY=
UPSTREAM_LLM_URL=https://api.openai.com/v1/chat/completions
DEFAULT_MODEL=gpt-3.5-turbo
FALLBACK_MODEL=qwen2.5:1.5b
ENABLE_PROVIDER_FALLBACK=true
# Privacy/Data Residency: set true ONLY if local on-premise model failures may fall back to cloud APIs
ALLOW_CLOUD_FALLBACK=false
GROQ_API_KEY=
ANTHROPIC_API_KEY=
UPSTREAM_TIMEOUT_SEC=30

# Inbound Guard & Payload Limits
INJECTION_THRESHOLD=0.70
MAX_PROMPT_CHARS=20000

# Sliding-Window Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60

# Optional Gateway API Keys (Comma-separated; leave empty to disable auth in dev mode)
GATEWAY_API_KEYS=

# Separate Admin API Key for /v1/policy endpoints (required when GATEWAY_API_KEYS is set)
ADMIN_API_KEY=

# Presidio spaCy NER Model
SPACY_MODEL=en_core_web_sm

# SQLite Audit Database Path
SQLITE_DB_PATH=llmops.db

# SOC Dashboard Connection Settings
GATEWAY_URL=http://127.0.0.1:8000
DASHBOARD_GATEWAY_API_KEY=
DASHBOARD_ADMIN_API_KEY=
