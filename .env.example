# Enterprise LLM Guardrail & Gateway - Environment Example

# Gateway Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Upstream LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
UPSTREAM_LLM_URL=https://api.openai.com/v1/chat/completions
DEFAULT_MODEL=gpt-3.5-turbo

# Inbound Guard Configuration
INJECTION_THRESHOLD=0.70

# Redis Cache (Phase 3)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL Logging (Phase 4)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guardrail_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
