# Enterprise LLM Guardrail & Gateway - Environment Example

# Gateway Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Upstream LLM Configuration (Leave empty for simulated fallback mode)
OPENAI_API_KEY=
UPSTREAM_LLM_URL=https://api.openai.com/v1/chat/completions
DEFAULT_MODEL=gpt-3.5-turbo
UPSTREAM_TIMEOUT_SEC=30

# Inbound Guard & Payload Limits
INJECTION_THRESHOLD=0.70
MAX_PROMPT_CHARS=20000

# Sliding-Window Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60

# Optional Gateway API Keys (Comma-separated; leave empty to disable auth in dev mode)
GATEWAY_API_KEYS=

# SQLite Audit Database Path
SQLITE_DB_PATH=llmops.db
